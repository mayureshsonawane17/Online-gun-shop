<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Gun Shop — the online armoury</title>
<link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;0,700;1,400;1,600&display=swap" rel="stylesheet">
<style>
:root{--cream:#fffee8;--slate:#6e7f99;--ink:#3b3b3b}
*{box-sizing:border-box;margin:0}[hidden]{display:none!important}
html,body{height:100%;overflow:hidden;font-family:Lora,Georgia,serif;color:#fff;background:linear-gradient(180deg,#4a4a4a,#8f90ab)}
#v{position:fixed;inset:0;width:100%;height:100%;object-fit:cover;transform:scaleX(-1);opacity:0;transition:opacity .6s}
#v.on{opacity:1}
#shade{position:fixed;inset:0;pointer-events:none;background:radial-gradient(ellipse at 50% 40%,transparent 55%,rgba(0,0,0,.35))}
#c{position:fixed;inset:0;width:100%;height:100%}
header{position:fixed;left:40px;top:30px;display:flex;gap:16px;align-items:center;pointer-events:none}
h1{font-size:clamp(2rem,3.2vw,2.8rem);line-height:1;font-weight:700}h1 i{font-weight:400;color:#d6d9ee}
header p{font-size:11px;letter-spacing:.32em;text-transform:uppercase;margin-top:8px}
.card{background:var(--cream);color:var(--ink);border-radius:16px;box-shadow:0 10px 30px rgba(0,0,0,.25)}
#pick{position:fixed;left:40px;top:128px;padding:12px 18px;display:flex;gap:14px;align-items:center;border:0;font:inherit;cursor:pointer;text-align:left}
#pick canvas{width:96px;height:44px;border-right:1px solid #ddd;padding-right:12px}
.lab{font-size:11px;letter-spacing:.22em;text-transform:uppercase;font-weight:600}
#pick b{display:block;font-size:22px;font-weight:600;margin-top:2px}#pick b i{font-weight:400}
#intro{position:fixed;left:50%;top:50%;transform:translate(-50%,-50%);width:min(540px,92vw);padding:30px 34px}
#intro .tag{display:flex;justify-content:space-between;align-items:center}
.pill18{border:1.5px solid var(--ink);border-radius:99px;padding:4px 12px;font-size:13px;font-weight:600}
h2{font-size:clamp(2rem,4.2vw,3.3rem);line-height:1.05;font-weight:600;margin:16px 0 18px}h2 i{font-weight:400;color:var(--slate)}
hr{border:0;border-top:1px solid #6d6d6d;margin-bottom:18px}
ol{list-style:none;padding:0;display:grid;gap:14px;margin-bottom:22px}
ol li{display:flex;gap:16px;align-items:center;font-size:18px;line-height:1.4}
ol span{flex:none;width:34px;height:34px;border-radius:50%;background:var(--slate);color:#fff;display:grid;place-items:center;font-weight:600;font-size:14px}
.row{width:100%;display:flex;justify-content:space-between;align-items:center;background:#f7f8e6;border:1px solid #dcdcc4;border-radius:14px;padding:14px 18px;font:inherit;color:inherit;cursor:pointer;text-align:left;margin-bottom:14px}
.row b{display:block;font-size:18px}.row small{font-size:14px}
.go{width:100%;padding:16px;background:var(--slate);color:#fff;border:1px solid #5a6a85;border-radius:10px;font:600 16px Lora,serif;letter-spacing:.16em;text-transform:uppercase;cursor:pointer;box-shadow:0 6px 14px rgba(70,80,110,.35)}
.note{font-style:italic;font-size:14px;color:#555;margin:14px 0 10px}
.alt{display:block;margin:0 auto;background:0;border:0;font:600 12px Lora,serif;letter-spacing:.16em;text-transform:uppercase;color:#44506b;cursor:pointer}
#hud{position:fixed;right:40px;top:30px;text-align:right;max-width:min(520px,60vw);pointer-events:none;text-shadow:0 2px 12px rgba(0,0,0,.5)}
#lab{font-size:12px;letter-spacing:.3em;text-transform:uppercase;font-weight:600}
#ins{font-size:clamp(1.3rem,2.4vw,2.1rem);font-weight:600;line-height:1.2;margin:10px 0 12px}
#am{font-style:italic;font-size:15px}#bar{height:2px;background:rgba(255,255,255,.35);margin-top:8px}#bar i{display:block;height:100%;background:#fff;transition:width .15s}
#pills{position:fixed;bottom:28px;left:50%;transform:translateX(-50%);display:flex;gap:12px}
.pill{background:var(--cream);color:var(--ink);border:0;border-radius:99px;padding:13px 26px;font:18px Lora,serif;cursor:pointer;box-shadow:0 4px 14px rgba(0,0,0,.2)}
#foot{position:fixed;right:40px;bottom:24px;text-align:right;font-size:14px;line-height:1.5;text-shadow:0 1px 8px rgba(0,0,0,.5);pointer-events:none}
#drawers{position:fixed;left:50%;top:50%;transform:translate(-50%,-50%);width:min(820px,94vw);max-height:88vh;overflow:auto;padding:28px 30px;animation:slide .35s cubic-bezier(.2,.8,.2,1)}
@keyframes slide{from{transform:translate(-50%,-38%);opacity:0}}
#drawers h2{margin:6px 0 4px;font-size:2.4rem}#drawers p{font-style:italic;margin-bottom:18px}
#grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:12px}
#grid button{background:#f7f8e6;border:1px solid #dcdcc4;border-radius:12px;padding:12px;font:inherit;color:inherit;cursor:pointer;text-align:left;border-bottom:5px solid #c9a24e}
#grid button.on{outline:2px solid var(--slate)}#grid canvas{width:100%;height:70px;display:block}
#grid b{display:block;font-size:17px;margin-top:6px}#grid i{font-size:13px;color:#555}
#x{position:absolute;right:18px;top:14px;background:0;border:0;font-size:28px;cursor:pointer;color:var(--ink)}
</style></head><body>
<video id="v" playsinline muted></video><div id="shade"></div><canvas id="c"></canvas>
<header><svg width="40" height="40" viewBox="0 0 40 40" fill="none" stroke="#fff" stroke-width="3"><circle cx="20" cy="20" r="14"/><path d="M20 2v10M20 28v10M2 20h10M28 20h10" stroke-width="2"/></svg>
<div><h1>Gun <i>Shop</i></h1><p>The online armoury</p></div></header>
<button id="pick" class="card"><canvas width="192" height="88"></canvas><span><span class="lab">Pick your gun</span><b></b></span></button>

<section id="intro" class="card">
<div class="tag"><span class="lab">● Gun Shop</span><span class="pill18">18+</span></div>
<h2>Handle a gun with your <i>hands.</i></h2><hr>
<ol><li><span>01</span>Close your fist inside the circle to pick the gun up.</li>
<li><span>02</span>Point like a finger gun, raise your thumb, then drop it to fire.</li>
<li><span>03</span>Open your palm to put the gun back.</li></ol>
<button class="row" id="pick2"><span><b>Pick your gun</b><small></small></span><span>↗</span></button>
<button class="go" id="go">Turn on my camera</button>
<p class="note">Your camera stays on your device. Nothing is recorded or sent anywhere.</p>
<button class="alt" id="mouse">No camera? Try it with your mouse</button></section>

<div id="hud" hidden><div id="lab"></div><div id="ins"></div><div id="am"></div><div id="bar"><i></i></div></div>
<div id="drawers" class="card" hidden><button id="x">×</button><h2>Pick your <i>gun.</i></h2><p>Each drawer holds one. Tap to take it out.</p><div id="grid"></div></div>
<nav id="pills"><button class="pill" id="sw">switch gun</button><button class="pill" id="rs">reset</button></nav>
<div id="foot">18+ · A simulation. Nothing real is fired.<br>← → switch gun</div>

<script>
const $=s=>document.querySelector(s),cv=$('#c'),X=cv.getContext('2d'),vid=$('#v');
let W,H,D;function rs(){D=Math.min(devicePixelRatio||1,2);W=innerWidth;H=innerHeight;cv.width=W*D;cv.height=H*D;X.setTransform(D,0,0,D,0,0)}
addEventListener('resize',rs);rs();

/* ---------- guns: sprites cut from your sheet (all flipped to face right) ---------- */
const B='#d8b45a';
const SPR={"g00": "data:image/png;base64,", "g01": "data:image/png;base64,", "g02": "data:image/png;base64,", "g03": "data:image/png;base64,", "g04": "data:image/png;base64,", "g05": "data:image/png;base64,", "g06": "data:image/png;base64,", "g07": "data:image/png;base64,", "g08": "data:image/png;base64,", "g09": "data:image/png;base64,", "g10": "data:image/png;base64,", "g11": "data:image/png;base64,", "g12": "data:image/png;base64,", "g13": "data:image/png;base64,", "g14": "data:image/png;base64,", "g15": "data:image/png;base64,", "g16": "data:image/png;base64,", "g17": "data:image/png;base64,", "g18": "data:image/png;base64,", "g19": "data:image/png;base64,", "g20": "data:image/png;base64,", "g21": "data:image/png;base64,", "g22": "data:image/png;base64,", "g23": "data:image/png;base64,", "g24": "data:image/png;base64,", "g25": "data:image/png;base64,", "g26": "data:image/png;base64,", "g27": "data:image/png;base64,", "g28": "data:image/png;base64,", "g29": "data:image/png;base64,", "g30": "data:image/png;base64,", "g31": "data:image/png;base64,", "g32": "data:image/png;base64,", "g33": "data:image/png;base64,", "g34": "data:image/png;base64,", "g35": "data:image/png;base64,", "g36": "data:image/png;base64,", "g37": "data:image/png;base64,", "g38": "data:image/png;base64,", "g39": "data:image/png;base64,", "g40": "data:image/png;base64,", "g41": "data:image/png;base64,", "g42": "data:image/png;base64,", "g43": "data:image/png;base64,", "g44": "data:image/png;base64,", "g45": "data:image/png;base64,", "g46": "data:image/png;base64,", "g47": "data:image/png;base64,"};
const META={"g00": {"w": 161, "h": 124, "my": 0.144}, "g01": {"w": 177, "h": 130, "my": 0.162}, "g02": {"w": 182, "h": 131, "my": 0.153}, "g03": {"w": 227, "h": 130, "my": 0.155}, "g04": {"w": 230, "h": 117, "my": 0.362}, "g05": {"w": 179, "h": 117, "my": 0.148}, "g06": {"w": 263, "h": 128, "my": 0.353}, "g07": {"w": 193, "h": 136, "my": 0.307}, "g08": {"w": 248, "h": 112, "my": 0.621}, "g09": {"w": 229, "h": 117, "my": 0.395}, "g10": {"w": 212, "h": 134, "my": 0.294}, "g11": {"w": 276, "h": 117, "my": 0.298}, "g12": {"w": 271, "h": 127, "my": 0.343}, "g13": {"w": 248, "h": 117, "my": 0.337}, "g14": {"w": 228, "h": 118, "my": 0.322}, "g15": {"w": 248, "h": 127, "my": 0.366}, "g16": {"w": 238, "h": 73, "my": 0.28}, "g17": {"w": 258, "h": 77, "my": 0.195}, "g18": {"w": 263, "h": 103, "my": 0.325}, "g19": {"w": 243, "h": 106, "my": 0.27}, "g20": {"w": 241, "h": 98, "my": 0.253}, "g21": {"w": 233, "h": 78, "my": 0.47}, "g22": {"w": 269, "h": 88, "my": 0.377}, "g23": {"w": 249, "h": 87, "my": 0.431}, "g24": {"w": 277, "h": 111, "my": 0.381}, "g25": {"w": 241, "h": 112, "my": 0.331}, "g26": {"w": 236, "h": 99, "my": 0.399}, "g27": {"w": 242, "h": 81, "my": 0.493}, "g28": {"w": 261, "h": 77, "my": 0.373}, "g29": {"w": 239, "h": 81, "my": 0.455}, "g30": {"w": 270, "h": 73, "my": 0.257}, "g31": {"w": 230, "h": 91, "my": 0.693}, "g32": {"w": 257, "h": 69, "my": 0.468}, "g33": {"w": 233, "h": 89, "my": 0.48}, "g34": {"w": 224, "h": 76, "my": 0.48}, "g35": {"w": 235, "h": 87, "my": 0.464}, "g36": {"w": 274, "h": 116, "my": 0.37}, "g37": {"w": 273, "h": 122, "my": 0.295}, "g38": {"w": 258, "h": 147, "my": 0.398}, "g39": {"w": 254, "h": 120, "my": 0.412}, "g40": {"w": 236, "h": 102, "my": 0.84}, "g41": {"w": 207, "h": 135, "my": 0.522}, "g42": {"w": 291, "h": 96, "my": 0.477}, "g43": {"w": 300, "h": 105, "my": 0.424}, "g44": {"w": 189, "h": 88, "my": 0.492}, "g45": {"w": 217, "h": 99, "my": 0.487}, "g46": {"w": 212, "h": 95, "my": 0.332}, "g47": {"w": 276, "h": 110, "my": 0.495}};
const CAT={
Pistol:{w:190,t:'Pistol',mag:15,rate:220,auto:0,rl:1100,sk:3,rc:.8,s:{f:5000,d:.12,v:.7,t:180},cs:B,ej:[.5,.1]},
Revolver:{w:220,t:'Revolver',mag:6,rate:450,auto:0,rl:1900,sk:5,rc:1.2,s:{f:3500,d:.22,v:.9,t:130},cs:0,ej:0},
SMG:{w:260,t:'SMG',mag:30,rate:70,auto:1,rl:1300,sk:2,rc:.45,s:{f:6000,d:.08,v:.55,t:200},cs:B,ej:[.5,.3]},
Rifle:{w:340,t:'Assault rifle',mag:30,rate:95,auto:1,rl:1500,sk:3,rc:.6,s:{f:4200,d:.14,v:.75,t:120},cs:B,ej:[.5,.3]},
Sniper:{w:400,t:'Sniper rifle',mag:5,rate:1100,auto:0,rl:1900,sk:8,rc:1.5,big:1,s:{f:2000,d:.5,v:1,t:70},cs:B,ej:[.45,.3]},
Shotgun:{w:350,t:'Shotgun',mag:6,rate:800,auto:0,rl:1700,sk:9,rc:1.6,big:1,s:{f:2500,d:.35,v:1,t:90},cs:'#c0392b',ej:[.45,.3]},
LMG:{w:380,t:'Machine gun',mag:100,rate:100,auto:1,rl:2800,sk:4,rc:.7,big:1,s:{f:3000,d:.16,v:.9,t:100},cs:B,ej:[.5,.3]},
Launcher:{w:400,t:'Launcher',mag:1,rate:1500,auto:0,rl:2800,sk:16,rc:1.8,big:1,back:1,s:{f:1800,d:.6,v:1,t:60},cs:0,ej:0}};
const AK={rate:105,rc:.75,s:{f:3800,d:.15,v:.85,t:110}};
const LIST=[
[0,'Glock 17','Pistol'],[1,'M1911','Pistol',{mag:8,rate:240}],[2,'Beretta 92','Pistol',{rate:230}],[3,'Python .357','Revolver'],[4,'MAC-10','SMG',{rate:50,mag:30}],[5,'Glock 19 Tan','Pistol'],
[6,'MP5K','SMG'],[7,'Mini Uzi','SMG',{rate:60,mag:32}],[8,'P90','SMG',{mag:50,rate:60}],[9,'KRISS Vector','SMG',{rate:50,mag:25}],[10,'MPX','SMG',{rate:70}],[11,'Compact Carbine','Rifle',{rate:85}],
[12,'M4A1','Rifle'],[13,'Mk18 Tan','Rifle'],[14,'M4 Optic','Rifle'],[15,'SCAR','Rifle',{rate:120,rc:.9,mag:20}],[16,'Tactical Shotgun','Shotgun',{mag:8,rate:600}],[17,'Remington 870','Shotgun'],
[18,'AK-47','Rifle',AK],[19,'AK-74','Rifle',AK],[20,'AK Blue Skin','Rifle',AK],[21,'Hunter Rifle','Sniper',{mag:5,rate:900,sk:6}],[22,'AWP','Sniper'],[23,'AWP Tan','Sniper'],
[24,'M24','Sniper',{mag:5}],[25,'Barrett M82','Sniper',{mag:10,rate:900,sk:12}],[26,'Camo Sniper','Sniper',{mag:10,rate:600}],[27,'AWM Tan','Sniper'],[28,'Kar98','Sniper',{mag:5,rate:1000}],[29,'Violet Sniper','Sniper',{mag:8,rate:700}],
[30,'Mossberg 500','Shotgun'],[31,'Coach Gun','Shotgun',{mag:2,rate:350,w:300}],[32,'Pump Shotgun','Shotgun',{mag:6,rate:700}],[33,'SPAS-12','Shotgun',{mag:8,rate:600}],[34,'Striker','Shotgun',{mag:12,rate:350}],[35,'KSG','Shotgun',{mag:14,rate:550}],
[36,'M249','LMG'],[37,'RPK','LMG',{mag:75,rate:100}],[38,'M60','LMG',{rate:95}],[39,'Minigun','LMG',{rate:35,mag:300,w:330,sk:5,s:{f:3500,d:.07,v:.5,t:110}}],[40,'Siege MG','LMG',{mag:120,rate:70,sk:5}],[41,'Block Gun','LMG',{mag:60,rate:80}],
[42,'RPG-7','Launcher'],[43,'RPG-7 Open','Launcher'],[44,'AT4','Launcher'],[45,'Grenade Launcher','Launcher',{mag:6,rate:700,sk:10,rl:2500,back:0}],[46,'Plasma Rifle','Rifle',{rate:90,fl:'90,170,255',s:{f:7000,d:.2,v:.6,t:260}}],[47,'Ion Cannon','LMG',{mag:80,rate:90,fl:'90,170,255',s:{f:6500,d:.25,v:.8,t:140}}]];
const G=LIST.map(([i,n,c,o])=>{const id='g'+String(i).padStart(2,'0'),m=META[id],g={id,n,...CAT[c],...o};g.img=new Image();g.img.onload=minis;g.img.src=SPR[id];
g.w=Math.min(g.w,m.w*1.3);g.k=g.w/m.w;g.len=m.w;g.hh=m.h;g.cx=m.w/2;g.cy=m.h/2;g.ax=m.w*.4;g.ay=m.h*.55;g.mz=[m.w,m.h*m.my];g.ej=g.ej&&[g.ej[0]*m.w,g.ej[1]*m.h];return g});
function paint(c,g){c.drawImage(g.img,0,0)}
function mini(cn,g){const c=cn.getContext('2d'),k=Math.min((cn.width-24)/g.len,(cn.height-12)/g.hh);c.clearRect(0,0,cn.width,cn.height);c.save();c.translate(cn.width/2,cn.height/2);c.scale(k,k);c.translate(-g.cx,-g.cy);paint(c,g);c.restore()}
function minis(){document.querySelectorAll('#grid canvas').forEach((c,i)=>mini(c,G[i]));label()}

/* ---------- sound (all synthesised) ---------- */
let AC,MS;function ac(){if(!AC){AC=new(window.AudioContext||window.webkitAudioContext)();MS=AC.createGain();MS.gain.value=.8;MS.connect(AC.destination);
const d=AC.createDelay(),f=AC.createGain(),lp=AC.createBiquadFilter();d.delayTime.value=.13;f.gain.value=.3;lp.frequency.value=1800;MS.connect(d);d.connect(lp);lp.connect(f);f.connect(d);lp.connect(AC.destination)}if(AC.state=='suspended')AC.resume();return AC}
function nz(d){const c=ac(),b=c.createBuffer(1,c.sampleRate*d,c.sampleRate),a=b.getChannelData(0);for(let i=0;i<a.length;i++)a[i]=(Math.random()*2-1)*Math.pow(1-i/a.length,2);return b}
function shot(s){const c=ac(),t=c.currentTime,n=c.createBufferSource(),f=c.createBiquadFilter(),g=c.createGain();n.buffer=nz(s.d+.25);f.type='lowpass';f.frequency.setValueAtTime(s.f,t);f.frequency.exponentialRampToValueAtTime(300,t+s.d+.1);g.gain.setValueAtTime(s.v,t);g.gain.exponentialRampToValueAtTime(.001,t+s.d+.2);n.connect(f);f.connect(g);g.connect(MS);n.start(t);
const o=c.createOscillator(),og=c.createGain();o.frequency.setValueAtTime(s.t,t);o.frequency.exponentialRampToValueAtTime(35,t+.18);og.gain.setValueAtTime(s.v*.9,t);og.gain.exponentialRampToValueAtTime(.001,t+.22);o.connect(og);og.connect(MS);o.start(t);o.stop(t+.25)}
function tick(at,fr,v,d=.04){const c=ac(),t=c.currentTime+at,n=c.createBufferSource(),f=c.createBiquadFilter(),g=c.createGain();n.buffer=nz(d);f.type='bandpass';f.frequency.value=fr;g.gain.value=v;n.connect(f);f.connect(g);g.connect(MS);n.start(t)}
const sndReload=()=>{tick(0,1500,1.4);tick(.28,900,1.6,.07);tick(.7,2200,1.4)};
const sndSlide=()=>{const c=ac(),t=c.currentTime,n=c.createBufferSource(),f=c.createBiquadFilter(),g=c.createGain();n.buffer=nz(.4);f.type='bandpass';f.frequency.setValueAtTime(300,t);f.frequency.linearRampToValueAtTime(1000,t+.35);g.gain.value=.7;n.connect(f);f.connect(g);g.connect(MS);n.start(t);tick(.36,700,1.2)};

/* ---------- state ---------- */
let sel=0,held=false,hp={x:0,y:0},ang=0,flip=false,reloading=false,last=0,kick=0,shake=0,flashT=0,wisp=0,wispT=0,shots=0,firedOnce=false,hover=false;
let mode='',hl=null,hand=null,td=false,prevTD=true,fistF=0,openF=0,lt=-1,T={};
const ammo=G.map(g=>g.mag),mouse={x:0,y:0,down:false,click:false};
const sm=[],rings=[],cas=[];
const R_=()=>({x:Math.max(200,Math.min(W*.2,300)),y:Math.max(H*.5,H-300)});
const rad=()=>{const g=G[sel];return g.len*g.k/2+50};

/* ---------- hand reading ---------- */
function mp(l){const vw=vid.videoWidth,vh=vid.videoHeight,s=Math.max(W/vw,H/vh);return[W-(l.x*vw*s-(vw*s-W)/2),l.y*vh*s-(vh*s-H)/2]}
function readHand(lm){const d=(i,j)=>Math.hypot(lm[i].x-lm[j].x,lm[i].y-lm[j].y),sz=d(0,9);
const e=[[8,6],[12,10],[16,14],[20,18]].map(([t,p])=>d(t,0)>d(p,0)*1.08),n=e.filter(Boolean).length;
const pose=n==4?'open':(e[0]&&!e[1]&&!e[2]&&!e[3])?'point':n==0?'fist':'other';
const ps=[0,5,9,13,17].map(i=>mp(lm[i])),w=mp(lm[0]),t=mp(lm[8]),th=d(4,10)/sz;
if(th<.6)td=true;else if(th>.85)td=false;
return{x:ps.reduce((s,q)=>s+q[0],0)/5,y:ps.reduce((s,q)=>s+q[1],0)/5,pose,a:Math.atan2(t[1]-w[1],t[0]-w[0]),td}}

/* ---------- smoke / fx ---------- */
const sp=document.createElement('canvas');sp.width=sp.height=128;
{const g=sp.getContext('2d'),r=g.createRadialGradient(64,64,0,64,64,64);r.addColorStop(0,'rgba(240,236,232,.9)');r.addColorStop(.5,'rgba(222,218,216,.45)');r.addColorStop(1,'rgba(210,208,212,0)');g.fillStyle=r;g.fillRect(0,0,128,128)}
const rnd=(a,b)=>a+Math.random()*(b-a);
function puff(x,y,dx,dy,v,r,life,al,gr,dr=1.6){sm.push({x,y,vx:dx*v+rnd(-20,20),vy:dy*v+rnd(-20,20)-10,r,g:gr,age:0,life,al,s:rnd(0,6),dr})}
function world(px,py){const g=G[sel],lx=(px-T.ax)*g.k,ly=(py-T.ay)*g.k*(T.fl?-1:1),c=Math.cos(T.a),s=Math.sin(T.a);return[T.x+lx*c-ly*s,T.y+lx*s+ly*c]}
function fire(now){const g=G[sel];if(reloading||ammo[sel]<=0||now-last<g.rate)return;
last=now;ammo[sel]--;kick=1;shake=Math.max(shake,g.sk);flashT=.08;wisp=3.4;shots++;firedOnce=true;shot(g.s);
const m=world(...g.mz),dx=Math.cos(T.a),dy=Math.sin(T.a),n=g.big?10:6;
for(let i=0;i<n;i++)puff(m[0],m[1],dx,dy,rnd(60,g.big?280:200),rnd(10,22)*(g.k>1?1.1:1),rnd(1.8,3.4),rnd(.32,.5),rnd(45,100));
if(g.back){const q=world(0,g.mz[1]);for(let i=0;i<9;i++)puff(q[0],q[1],-dx,-dy,rnd(80,280),rnd(14,26),rnd(1.8,3),rnd(.3,.45),rnd(50,90))}
if(g.rate>=200||shots%6==0)rings.push({x:m[0]+dx*14,y:m[1]+dy*14,dx,dy,v:rnd(140,200),R:9,age:0,life:2.7});
if(g.cs){const e=world(...g.ej),nx=-dy,ny=dx,sg=ny<0?1:-1;cas.push({x:e[0],y:e[1],vx:nx*sg*rnd(120,230)-dx*rnd(0,60),vy:ny*sg*rnd(120,230)-dy*rnd(0,60)-90,rot:0,sp:rnd(-18,18),age:0,c:g.cs})}
if(ammo[sel]==0)setTimeout(reload,450)}
function reload(){if(reloading||ammo[sel]==G[sel].mag)return;reloading=true;sndReload();const i=sel;setTimeout(()=>{ammo[i]=G[i].mag;reloading=false},G[sel].rl)}

/* ---------- grab / release / select ---------- */
function grab(){const g=G[sel],r=R_();held=true;hp={x:r.x+(g.ax-g.cx)*g.k,y:r.y+(g.ay-g.cy)*g.k};ang=0;flip=false;fistF=0;openF=0;prevTD=true;tick(0,1200,1.2)}
function drop(){if(!held)return;held=false;firedOnce=false;sndSlide()}
function choose(i){drop();sel=i;sndSlide();label()}
function label(){const g=G[sel];$('#pick b').innerHTML=g.n+' <i>'+g.t+'</i>';$('#pick2 small').textContent=g.n+' '+g.t+' selected';mini($('#pick canvas'),g)}
function openDrawers(){$('#drawers').hidden=false;$('#intro').style.visibility='hidden';sndSlide();$('#grid').querySelectorAll('button').forEach((b,i)=>b.classList.toggle('on',i==sel))}
function closeDrawers(){$('#drawers').hidden=true;$('#intro').style.visibility=''}
$('#grid').innerHTML=G.map((g,i)=>`<button data-i="${i}"><canvas width="340" height="130"></canvas><b>${g.n}</b><i>${g.t} · ${g.mag} rounds</i></button>`).join('');
$('#grid').onclick=e=>{const b=e.target.closest('button');if(b){choose(+b.dataset.i);closeDrawers()}};
$('#x').onclick=closeDrawers;$('#pick').onclick=$('#pick2').onclick=openDrawers;$('#sw').onclick=()=>sel==null||openDrawers();
$('#rs').onclick=()=>{drop();ammo.forEach((_,i)=>ammo[i]=G[i].mag);reloading=false;sm.length=rings.length=cas.length=0;wisp=0};

/* ---------- start ---------- */
function begin(m){mode=m;$('#intro').hidden=true;$('#hud').hidden=false;ac()}
$('#mouse').onclick=()=>begin('mouse');
$('#go').onclick=async()=>{const b=$('#go');ac();b.textContent='Starting camera…';
try{vid.srcObject=await navigator.mediaDevices.getUserMedia({video:{width:1280,height:720,facingMode:'user'}});await vid.play();vid.classList.add('on');b.textContent='Loading hand tracking…';
const v='0.10.14',{HandLandmarker:HL,FilesetResolver:FR}=await import('https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@'+v+'/+esm'),fs=await FR.forVisionTasks('https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@'+v+'/wasm'),
o={baseOptions:{modelAssetPath:'https://storage.googleapis.com/mediapipe-models/hand_landmarker/hand_landmarker/float16/1/hand_landmarker.task',delegate:'GPU'},runningMode:'VIDEO',numHands:1};
try{hl=await HL.createFromOptions(fs,o)}catch(e){o.baseOptions.delegate='CPU';hl=await HL.createFromOptions(fs,o)}
begin('cam')}catch(e){console.error(e);b.textContent='Camera or tracking failed — use mouse mode'}};
addEventListener('pointermove',e=>{mouse.x=e.clientX;mouse.y=e.clientY});
cv.addEventListener('pointerdown',e=>{if(e.button==0){mouse.down=true;mouse.click=true}});addEventListener('pointerup',()=>mouse.down=false);
addEventListener('contextmenu',e=>{if(mode=='mouse'){e.preventDefault();drop()}});
addEventListener('keydown',e=>{if(e.key=='Escape')drop();if(e.key=='r')reload();if(e.key=='ArrowRight')choose((sel+1)%G.length);if(e.key=='ArrowLeft')choose((sel+G.length-1)%G.length)});

/* ---------- frame ---------- */
function ell(x,y,rx,ry){X.beginPath();X.ellipse(x,y,rx,ry,0,0,7);X.fill();X.stroke()}
function stand(r,g){const rx=g.len*g.k/2+26,ty=r.y+26,gr=X.createLinearGradient(r.x-5,0,r.x+5,0);gr.addColorStop(0,'#a8863d');gr.addColorStop(.5,'#f0d98c');gr.addColorStop(1,'#a8863d');
X.fillStyle=gr;X.fillRect(r.x-5,ty+20,10,H-ty-48);X.lineWidth=2;X.strokeStyle='#d9b862';X.fillStyle='#15161c';ell(r.x,H-32,70,13);X.lineWidth=3;ell(r.x,ty,rx,34);X.lineWidth=1;X.strokeStyle='rgba(217,184,98,.6)';X.beginPath();X.ellipse(r.x,ty,rx-14,24,0,0,7);X.stroke()}
let prev=performance.now();
function frame(now){requestAnimationFrame(frame);const dt=Math.min((now-prev)/1000,.05);prev=now;const g=G[sel],r=R_(),R=rad();
if(mode=='cam'&&hl&&vid.readyState>=2&&vid.currentTime!=lt){lt=vid.currentTime;const o=hl.detectForVideo(vid,now);if(o.landmarks&&o.landmarks[0]){hand=readHand(o.landmarks[0]);hand.t=now}else if(hand&&now-hand.t>500)hand=null}
const inp=mode=='cam'?hand:mode=='mouse'?{x:mouse.x,y:mouse.y}:null;
if(!held){hover=!!inp&&Math.hypot(inp.x-r.x,inp.y-r.y)<R;
 if(mode=='cam'){fistF=hover&&hand.pose=='fist'?fistF+1:0;if(fistF>6)grab()}else if(mode=='mouse'&&mouse.click&&hover)grab()}
else{let tx=hp.x,ty=hp.y,ta=flip?Math.PI:0,trig=false;
 if(mode=='cam'&&hand){tx=hand.x;ty=hand.y;ta=hand.pose=='point'?hand.a:(hand.x<W/2?0:Math.PI);
  if(hand.pose=='point'){trig=g.auto?hand.td:(hand.td&&!prevTD);prevTD=hand.td}else prevTD=true;
  openF=hand.pose=='open'?openF+1:0;if(openF>14)drop()}
 else if(mode=='mouse'){tx=mouse.x;ty=mouse.y;ta=mouse.x<W/2?0:Math.PI;trig=g.auto?mouse.down:mouse.click}
 const a=1-Math.exp(-dt*18);hp.x+=(tx-hp.x)*a;hp.y+=(ty-hp.y)*a;let df=ta-ang;df=Math.atan2(Math.sin(df),Math.cos(df));ang+=df*(1-Math.exp(-dt*14));flip=Math.cos(ang)<0;
 if(held&&trig){T=tf();fire(now)}}
mouse.click=false;
kick*=Math.exp(-dt*9);shake*=Math.exp(-dt*11);flashT=Math.max(0,flashT-dt);T=tf();
if(wisp>0){wisp-=dt;wispT-=dt;if(wispT<=0){wispT=.07;const m=world(...g.mz);puff(m[0],m[1],0,-1,rnd(14,30),rnd(5,9),rnd(2,3.4),.16+rnd(0,.08),rnd(10,16),.9)}}
for(const p of sm){p.age+=dt;const k=Math.exp(-p.dr*dt);p.vx*=k;p.vy=p.vy*k-30*dt;p.x+=(p.vx+Math.sin(p.age*2.4+p.s)*12)*dt;p.y+=p.vy*dt;p.r+=p.g*dt}
for(const q of rings){q.age+=dt;q.x+=q.dx*q.v*dt;q.y+=q.dy*q.v*dt-14*dt;q.v*=Math.exp(-1.2*dt);q.R+=34*dt}
for(const c of cas){c.age+=dt;c.vy+=900*dt;c.x+=c.vx*dt;c.y+=c.vy*dt;c.rot+=c.sp*dt}
for(const a of[sm,rings,cas])for(let i=a.length-1;i>=0;i--)if(a[i].age>(a[i].life||1.5))a.splice(i,1);

X.clearRect(0,0,W,H);X.save();if(shake>.05)X.translate(rnd(-1,1)*shake*6,rnd(-1,1)*shake*6);
stand(r,g);
if(!held){X.beginPath();X.arc(r.x,r.y,R,0,7);X.strokeStyle=hover?'rgba(255,255,255,.95)':'rgba(255,255,255,.55)';X.lineWidth=1.5;X.stroke();
 if(fistF){X.beginPath();X.arc(r.x,r.y,R,-Math.PI/2,-Math.PI/2+Math.min(fistF/7,1)*6.283);X.strokeStyle='#fffee8';X.lineWidth=4;X.stroke()}
 if(mode=='cam'&&hand){X.beginPath();X.arc(hand.x,hand.y,9,0,7);X.strokeStyle='#fff';X.lineWidth=2;X.stroke()}}
X.save();X.translate(T.x,T.y);X.rotate(T.a);X.scale(g.k,T.fl?-g.k:g.k);X.translate(-T.ax,-T.ay);paint(X,g);X.restore();
for(const c of cas){X.save();X.globalAlpha=Math.min(1,(1.5-c.age)*2);X.translate(c.x,c.y);X.rotate(c.rot);X.fillStyle=c.c;X.fillRect(-5,-2,10,4);X.restore()}
for(const p of sm){const t=p.age/p.life;X.globalAlpha=p.al*Math.pow(1-t,1.5)*Math.min(1,p.age*8);X.drawImage(sp,p.x-p.r,p.y-p.r,p.r*2,p.r*2)}
for(const q of rings){const t=q.age/q.life,al=.26*Math.pow(1-t,1.4)*Math.min(1,q.age*6),nx=-q.dy,ny=q.dx,pr=q.R*.3+3;X.globalAlpha=al;
 for(let i=0;i<28;i++){const th=i/28*6.283,a=Math.cos(th)*q.R,b=Math.sin(th)*q.R*.38;X.drawImage(sp,q.x+nx*a+q.dx*b-pr,q.y+ny*a+q.dy*b-pr,pr*2,pr*2)}}
X.globalAlpha=1;
if(flashT>0){const m=world(...g.mz),f=flashT/.08,fr=(50+g.k*40)*f,gr=X.createRadialGradient(m[0],m[1],0,m[0],m[1],fr);gr.addColorStop(0,'rgba(255,244,200,1)');gr.addColorStop(.35,`rgba(${g.fl||'255,170,60'},.75)`);gr.addColorStop(1,`rgba(${g.fl||'255,100,20'},0)`);
 X.globalCompositeOperation='lighter';X.fillStyle=gr;X.beginPath();X.arc(m[0],m[1],fr,0,7);X.fill();X.strokeStyle='rgba(255,220,140,.8)';X.lineWidth=3;
 for(const o of[-.5,-.2,0,.2,.5]){const a=T.a+o+rnd(-.08,.08);X.beginPath();X.moveTo(m[0],m[1]);X.lineTo(m[0]+Math.cos(a)*fr*1.5,m[1]+Math.sin(a)*fr*1.5);X.stroke()}
 X.fillStyle=`rgba(255,200,120,${f*.09})`;X.fillRect(-20,-20,W+40,H+40);X.globalCompositeOperation='source-over'}
X.restore();hud()}
function tf(){const g=G[sel];if(!held){const r=R_();return{x:r.x,y:r.y,a:-.04,fl:0,ax:g.cx,ay:g.cy}}
const d=kick*16*g.rc*g.k;return{x:hp.x-Math.cos(ang)*d,y:hp.y-Math.sin(ang)*d,a:ang+(flip?1:-1)*kick*.14*g.rc,fl:flip,ax:g.ax,ay:g.ay}}
function hud(){if(!mode)return;const g=G[sel],cam=mode=='cam',n=ammo[sel],st=!held?1:firedOnce?3:2;
$('#lab').textContent='Step '+st+' of 3 · '+(reloading?'reloading':held?(performance.now()-last<250?'firing':'armed'):'resting');
$('#ins').textContent=[cam?'Close your fist inside the circle to pick the gun up':'Click inside the circle to pick the gun up',cam?'Point like a finger gun, raise your thumb, then drop it to fire':'Click to fire · hold for full auto',cam?'Open your palm to put it back':'Right-click or Esc to put it back'][st-1];
$('#am').textContent=(reloading?'reloading…':n+' / '+g.mag+' rounds')+' · '+g.n+(g.auto?' · full auto':' · semi auto');
$('#bar i').style.width=(reloading?0:n/g.mag*100)+'%'}
label();requestAnimationFrame(frame);
</script></body></html>
